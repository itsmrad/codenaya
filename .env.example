# Copy to .env.local for local dev, or inject from Infisical (see README,
# "Environment & secrets"). Never commit real values.
#
# Where each variable goes:
#   [Next]   the Next.js host (.env.local / Infisical / Vercel)
#   [Convex] the Convex deployment: `npx convex env set NAME value`
#   [Both]   the same value in both places
#   [CLI]    read by tooling only (Convex CLI), not by app code
#
# Optional variables are commented out: uncomment one only to set a value.
# Some treat an empty value differently from an unset one.

# ============================================================================
# Required
# ============================================================================

# --- Clerk authentication ---
# [Next] Clerk publishable key (pk_...).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# [Next] Clerk secret key (sk_...).
CLERK_SECRET_KEY=
# [Convex] Clerk Frontend API URL, so Convex accepts Clerk JWTs.
CLERK_JWT_ISSUER_DOMAIN=
# [Convex] Signing secret (whsec_...) for the Clerk user-sync webhook. Clerk
# dashboard > Webhooks: add https://<deployment>.convex.site/clerk-users-webhook
# with events user.created, user.updated, user.deleted. Also enable
# "Delete account" under User & authentication > Account settings.
CLERK_WEBHOOK_SECRET=

# --- Convex ---
# [Next] Convex deployment URL (https://<deployment>.convex.cloud).
NEXT_PUBLIC_CONVEX_URL=
# [CLI] Deployment the Convex CLI targets; written by `convex dev`.
CONVEX_DEPLOYMENT=
# [Both] Shared secret for server-to-Convex internal calls. Any long random
# string, e.g. `openssl rand -base64 32`.
CODENAYA_CONVEX_INTERNAL_KEY=

# --- Cloud sandbox previews ---
# [Next] E2B API key.
E2B_API_KEY=

# --- LLM provider (agent and editor AI) ---
# [Next] Platform provider until the admin picks one in /admin (ADR 0006):
# openrouter (default), openai, anthropic or groq. Public (no secret); an
# invalid value falls back to openrouter.
NEXT_PUBLIC_AI_PROVIDER=openrouter
# [Next] The active provider's key is required; set others to switch to them
# from /admin.
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# [Next] "true" refuses platform sends past the free credit grant (ADR 0011).
# Unset = usage is recorded but never refused (until billing is live).
# CREDIT_LIMITS_ENFORCED=

# [Convex] The one admin (/admin): a verified Clerk email. Unset = no admin.
# Set it on the Convex deployment (`npx convex env set ADMIN_EMAIL ...`).
# ADMIN_EMAIL=
# [Convex] Pins the admin to one Clerk user id too (user_...), so a reassigned
# email can't become admin (ADR 0010). Unset = the email rule alone.
# ADMIN_USER_ID=

# --- Credential encryption ---
# [Next] Master key (KEK) for stored integration credentials, e.g.
# `openssl rand -base64 32`. Use the same value in every environment; losing it
# makes stored credentials unrecoverable.
CODENAYA_LOCAL_KEK=

# ============================================================================
# Optional
# ============================================================================

# --- Sentry (error tracking; reports from production builds only) ---
# [Next] DSN for the browser, inlined at build time. Sentry is off when unset.
# NEXT_PUBLIC_SENTRY_DSN=
# [Next] DSN for the server and edge runtimes. Default: NEXT_PUBLIC_SENTRY_DSN.
# SENTRY_DSN=
# [Next] Share of traces sent, 0 to 1, in every runtime. Default: 0.1.
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# [CLI] Auth token for source-map upload during `next build`. Skipped when unset.
# SENTRY_AUTH_TOKEN=
# [CLI] Sentry org slug. Default: the org named in an org-scoped SENTRY_AUTH_TOKEN.
# SENTRY_ORG=
# [CLI] Sentry project slug. Default: codenaya.
# SENTRY_PROJECT=

# --- Sandbox ---
# [Next] E2B template with Node 22 (build with `npm run e2b:template`). Default: base.
# E2B_TEMPLATE=

# --- App URL ---
# [Next] Public origin (e.g. https://codenaya.example.com) for metadata and the
# OAuth callback fallback. Default: https://$VERCEL_PROJECT_PRODUCTION_URL on
# Vercel (set by Vercel automatically), else http://localhost:3000 for metadata.
# NEXT_PUBLIC_APP_URL=

# --- Integrations (MCP) ---
# [Next] Absolute OAuth callback URL (https off localhost), e.g.
# http://localhost:3000/api/integrations/oauth/callback. Default: built from
# NEXT_PUBLIC_APP_URL; OAuth connections fail when neither resolves.
# INTEGRATIONS_REDIRECT_URI=
# [Next] Firecrawl API key for web scraping. Feature is off when unset.
# FIRECRAWL_API_KEY=
# [Next] Set to 1 to allow http:// MCP URLs. Ignored when NODE_ENV=production.
# CODENAYA_ALLOW_INSECURE_MCP_URLS=

# --- Credential encryption (advanced) ---
# [Next] KEK provider: local (default) or gcp-kms.
# CODENAYA_KEK_PROVIDER=
# [Next] Comma-separated decrypt-only old keys, for KEK rotation.
# CODENAYA_LOCAL_KEK_RETIRED=
# [Next] Only for CODENAYA_KEK_PROVIDER=gcp-kms: full Cloud KMS key name
# (projects/<p>/locations/<l>/keyRings/<r>/cryptoKeys/<k>).
# CODENAYA_GCP_KMS_KEY=

# --- Google Cloud (Cloud KMS) ---
# [Next] Service account email; used by gcp-kms.
# GOOGLE_CLIENT_EMAIL=
# [Next] Service account private key (PEM; literal \n line breaks are accepted).
# GOOGLE_PRIVATE_KEY=

# --- Showcase ---
# [Convex] Comma-separated Clerk user ids (e2e pool, test accounts) whose
# showcase entries publish unlisted. Unset in dev: the feed specs need them listed.
# SHOWCASE_UNLISTED_OWNER_IDS=

# --- Inngest (read by the Inngest SDK) ---
# [Next] Set to 1 locally to use the Inngest dev server (`npx inngest-cli@latest dev`).
# Leave unset in production.
# INNGEST_DEV=1
# [Next] Inngest Cloud event key. Required in production.
# INNGEST_EVENT_KEY=
# [Next] Inngest Cloud signing key. Required in production.
# INNGEST_SIGNING_KEY=

# Not listed above on purpose: NODE_ENV, NEXT_RUNTIME, CI (set by the runtime),
# VERCEL_PROJECT_PRODUCTION_URL (set by Vercel), and TARGET_PORT / PROXY_PORT
# (read by the preview proxy script inside the sandbox, not by the app). KEY,
# API_KEY and VITE_* only appear inside prompt/test strings.
# NEXT_PUBLIC_CONVEX_SITE_URL is written by `convex dev`, but nothing reads it.
# E2E_* vars are test-only: see README, "Running e2e tests".
