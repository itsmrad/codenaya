# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex client and deployment
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=

# Set this same value in the Next.js host and the selected Convex deployment.
CODENAYA_CONVEX_INTERNAL_KEY=

# Set this in the Convex deployment so Clerk JWTs are accepted by Convex.
CLERK_JWT_ISSUER_DOMAIN=

# Cloud sandbox previews
E2B_API_KEY=

# Agent model
OPENROUTER_API_KEY=

# Credential encryption
CODENAYA_LOCAL_KEK=

# Optional integrations
FIRECRAWL_API_KEY=
INTEGRATIONS_REDIRECT_URI=
