# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex client and deployment
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
CONVEX_DEPLOYMENT=

# Set this same value in the Next.js host and the selected Convex deployment.
CODENAYA_CONVEX_INTERNAL_KEY=

# Set this in the Convex deployment so Clerk JWTs are accepted by Convex.
CLERK_JWT_ISSUER_DOMAIN=

# Set this in the Convex deployment (not Next.js). Clerk dashboard > Webhooks:
# add endpoint https://<deployment>.convex.site/clerk-users-webhook with events
# user.created, user.updated, user.deleted, and copy its signing secret (whsec_...).
# Also enable "Delete account" under User & authentication > Account settings.
CLERK_WEBHOOK_SECRET=

# Cloud sandbox previews
E2B_API_KEY=

# LLM provider for the agent and editor AI (suggestions, Cmd+K quick edit)
OPENROUTER_API_KEY=
# Optional OpenRouter model ids for editor AI (default: openai/gpt-5.4-mini)
OPENROUTER_SUGGESTION_MODEL=
OPENROUTER_QUICK_EDIT_MODEL=

# Credential encryption
CODENAYA_LOCAL_KEK=

# Optional integrations
FIRECRAWL_API_KEY=
INTEGRATIONS_REDIRECT_URI=
